# AIOL environment for docker compose (and for a local backend run).
# Copy to .env and fill in. NEVER commit .env.
# Every variable cloud-core reads is listed here with its default (cloud-core/app/core/config.py is the source).
# A commented line keeps the built-in default; uncomment to change it. Leave an optional setting commented
# out rather than empty: an empty value is read as "" (and an empty boolean refuses to start), not as unset.

# =========================================================================================
# 1. Docker compose (read by docker-compose.yml, not by the app)
# =========================================================================================
POSTGRES_USER=aiol
# Use a strong password in production; the API refuses to boot in production with the dev default.
# Letters and digits only, or URL-encode it: it is placed inside DATABASE_URL.
POSTGRES_PASSWORD=aiol_dev_password
POSTGRES_DB=aiol
# Host ports. Postgres and Redis bind to 127.0.0.1 only.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=8000
# HARNESS_PORT=8080
# Redis URL the containers use (set a password-protected one in production: redis://:<password>@redis:6379/0).
# REDIS_URL_INTERNAL=redis://redis:6379/0

# =========================================================================================
# 2. Required for every deployment (security audit SEC-09)
# =========================================================================================
# production | development. The image defaults to production; use development for local work.
APP_ENV=production
APP_DEBUG=false
# JWT signing key, at least 32 characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Used by a backend run OUTSIDE Docker (the containers build their own from POSTGRES_* above).
DATABASE_URL=postgresql+psycopg://aiol:aiol_dev_password@localhost:5432/aiol
REDIS_URL=redis://localhost:6379/0
# Fernet key for stored AI-provider credentials, separate from SECRET_KEY. Keep it: a new key cannot
# decrypt credentials stored with the old one.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CREDENTIAL_KEY=
# Reverse proxies YOU run in front of the API (each appends to X-Forwarded-For). 0 = reached directly.
TRUSTED_PROXY_HOPS=0
# Browser origins allowed to call the API, exact and comma-separated, never "*". Include the harness.
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Only for a website on another origin that uses the browser-session cookie.
# CORS_ALLOW_CREDENTIALS=false

# =========================================================================================
# 3. Application
# =========================================================================================
# APP_NAME=AI Operating Layer
# CORE_VERSION=0.13.0
# API_V1_PREFIX=/api/v1
# API_HOST=0.0.0.0
# API_PORT=8000
# LOG_LEVEL=INFO
# Largest request body accepted at all (bytes): the 50 MiB upload limit plus multipart overhead.
# MAX_REQUEST_BODY_BYTES=53477376
# Vector size of stored embeddings.
# EMBEDDING_DIMENSIONS=1536

# =========================================================================================
# 4. AI model providers (AIExecution, AI Center)
# =========================================================================================
# Environment-level adapters. Unset = "not configured": no model call is made.
# AI Center accounts store their own encrypted key (AI_CREDENTIAL_KEY above).
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com
# OPENAI_API_KEY=
# OPENAI_API_BASE_URL=https://api.openai.com
# AI_PROVIDER_TIMEOUT_SECONDS=30
# Larger provider responses are recorded as failed, never buffered without limit.
# AI_MAX_RESPONSE_BYTES=1000000
# Prices per million tokens, keyed "provider/model". A model not listed has UNKNOWN cost (NULL, never 0):
# AI_MODEL_PRICING_JSON={"anthropic/claude-haiku-4-5-20251001":{"input_per_mtok":"<price>","output_per_mtok":"<price>","currency":"USD"}}
# AI_MODEL_PRICING_JSON=
# AI_VISIBILITY_MODEL=claude-haiku-4-5-20251001
# Comma-separated "provider/model" fallback targets, tried in order.
# AI_VISIBILITY_FALLBACK_TARGETS=
# AI_VISIBILITY_MAX_OUTPUT_TOKENS=400
# AI_ATTEMPTS_PER_TARGET=2
# A RUNNING execution older than this is reclaimed as ABANDONED (keep well above the provider timeout).
# AI_EXECUTION_STALE_SECONDS=900
# AI_EXECUTION_RECLAIM_INTERVAL_SECONDS=300
# AI job lease, renewed before every item; must exceed one provider call.
# AI_JOB_LEASE_SECONDS=900
# AI_JOB_MAX_AUTO_RESUMES=24
# AI_JOB_RECOVERY_INTERVAL_SECONDS=120
# How often a stalled document ingestion job (past its 15-minute lease) is reclaimed.
# INGESTION_RECLAIM_INTERVAL_SECONDS=300
# Prompt-injection defences (ADR-126).
# AI_SYSTEM_POLICY_ENABLED=true
# PROMPT_INJECTION_QUARANTINE=true
# Optional semantic memory backend (Walrus). Unset = native memory only.
# WALRUS_API_URL=
# WALRUS_DELEGATE_KEY=

# =========================================================================================
# 5. Documents
# =========================================================================================
# DOCUMENT_PROVIDER_ORDER=local_pdf,mathpix,markitdown,image_ocr
# DOCUMENT_MAX_PAGES=2000
# Below this extraction confidence the next provider is tried; failing that, the document is flagged for review.
# DOCUMENT_MIN_CONFIDENCE=0.5
# Mathpix sends documents OFF this deployment: tried only when both are set.
# MATHPIX_APP_ID=
# MATHPIX_APP_KEY=
# MATHPIX_API_BASE_URL=https://api.mathpix.com
# MATHPIX_POLL_TIMEOUT_SECONDS=600

# =========================================================================================
# 6. Sign-in, sessions and e-mail
# =========================================================================================
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# ALGORITHM=HS256
# BROWSER_ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=14
# SESSION_COOKIE_NAME=aiol_session
# strict when site and API share a registrable domain; "none" (Secure) only for a cross-site deployment.
# SESSION_COOKIE_SAMESITE=strict
# SESSION_COOKIE_DOMAIN=
# NATIVE_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Legacy password registration skips e-mail verification. Empty = enabled outside production only.
# PASSWORD_REGISTRATION_ENABLED=
# REGISTRATION_IP_LIMIT_PER_HOUR=10
# LOGIN_PASSWORD_IP_LIMIT_PER_MINUTE=20
# LOGIN_PASSWORD_ACCOUNT_LIMIT_PER_15_MIN=10
# E-mailed one-time login codes.
# LOGIN_CODE_TTL_SECONDS=300
# LOGIN_CODE_RESEND_SECONDS=300
# LOGIN_CODE_MAX_FAILURES=3
# LOGIN_CODE_FIRST_LOCK_SECONDS=3600
# LOGIN_CODE_SECOND_LOCK_SECONDS=86400
# LOGIN_CODE_IP_LIMIT_PER_MINUTE=30
# SMTP. Unset SMTP_HOST = delivery not configured: login codes are refused honestly, never faked.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# SMTP_FROM=no-reply@localhost

# =========================================================================================
# 7. Research, demand and visibility connectors (unset = BLOCKED_EXTERNAL_DEPENDENCY)
# =========================================================================================
# Crossref / NCBI / Europe PMC need no key; a contact address is polite.
# RESEARCH_CONTACT_EMAIL=
# NCBI_API_KEY=
# GSC_OAUTH_CLIENT_ID=
# GSC_OAUTH_CLIENT_SECRET=
# GA4_OAUTH_CLIENT_ID=
# GA4_OAUTH_CLIENT_SECRET=

# =========================================================================================
# 8. Payments (out of scope for this release; empty = no provider)
# =========================================================================================
# PAYMENT_PROVIDER=
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# WALLET_CURRENCY=USD

# =========================================================================================
# 9. Official client suite (ADR-137..140)
# =========================================================================================
# Links the native clients show; unset = the menu item is hidden. Production requires https.
# CLIENT_HELP_URL=
# CLIENT_LEARN_MORE_URL=
# CLIENT_PRIVACY_URL=
# CLIENT_TERMS_URL=
# CLIENT_DOCS_URL=
# CLIENT_REPORT_PROBLEM_URL=
# CLIENT_UPGRADE_URL=
# JSON list of published downloads: [{"platform":"windows","status":"AVAILABLE","version":"0.1.0","url":"https://..."}]
# CLIENT_RELEASES_JSON=
# CLIENT_UPGRADE_PLATFORMS=web,windows,macos
# CLIENT_TERMS_VERSION=2026-11-01
# Signed desktop updates, keyed "<platform>-<arch>": {"version","url","signature",...}. Empty = none offered.
# CLIENT_UPDATES_JSON=

# =========================================================================================
# 10. Device Intelligence (ADR-138)
# =========================================================================================
# DEVICE_INTELLIGENCE_ENABLED=true
# DEVICE_CHALLENGE_TTL_SECONDS=120
# DEVICE_OBSERVATION_RETENTION_DAYS=90
# DEVICE_PURGE_INTERVAL_SECONDS=3600
# Keyed pseudonyms for network observations; falls back to a key derived from SECRET_KEY.
# DEVICE_PSEUDONYM_KEY=
# DEVICE_PSEUDONYM_KEY_VERSION=1

# =========================================================================================
# 11. Real-key E2E (scripts/start-real-e2e.ps1, docs/e2e-real-keys.md) - read by the test, not the app
# =========================================================================================
# AIOL_TOKEN=
# AIOL_TOPIC_ID=
# AIOL_MODEL=claude-haiku-5-5
