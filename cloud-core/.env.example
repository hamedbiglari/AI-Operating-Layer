# cloud-core environment template. Copy to .env and fill in. NEVER commit .env.
# Every setting and its default lives in app/core/config.py; the ones below are the ones a deployment must set.

# --- Required for any deployment (security audit 2026-10-14, SEC-09) ---
# With APP_ENV=production the service refuses to start while any of these still holds a development default.
APP_ENV=production
APP_DEBUG=false
# JWT signing key, at least 32 characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://aiol:<strong-password>@postgres:5432/aiol
# Use a password-protected Redis (redis://:<password>@redis:6379/0) or a private network.
REDIS_URL=redis://redis:6379/0
# Fernet key for stored AI-provider credentials, separate from SECRET_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CREDENTIAL_KEY=
# Number of reverse proxies YOU run in front of the API (each appends to X-Forwarded-For). Per-address rate
# limits use the client address they report; leave 0 when the API is reached directly.
TRUSTED_PROXY_HOPS=0
# Legacy password registration (/auth/register-organization) skips e-mail verification. Empty = off in
# production; the public sign-up is the emailed-code flow.
PASSWORD_REGISTRATION_ENABLED=

# --- Phase 17: AI model provider (AIExecution) ---
# Leave empty unless a real credential is provisioned. Unset = the provider is
# "not configured": no model call is made and no AIExecution row is written.
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_MAX_RESPONSE_BYTES=1000000

# Prices are configuration, never hardcoded. A model not listed here has
# UNKNOWN cost (stored as NULL, never 0), and a Visibility run refuses to
# spend against an unknown cost. Fill with the provider's current published
# prices, per million tokens:
# AI_MODEL_PRICING_JSON={"anthropic/claude-haiku-4-5-20251001":{"input_per_mtok":"<price>","output_per_mtok":"<price>","currency":"USD"}}
AI_MODEL_PRICING_JSON=

AI_VISIBILITY_MODEL=claude-haiku-4-5-20251001
# Comma-separated provider/model fallback targets, tried in order.
AI_VISIBILITY_FALLBACK_TARGETS=
AI_VISIBILITY_MAX_OUTPUT_TOKENS=400
AI_ATTEMPTS_PER_TARGET=2
# A RUNNING execution older than this is reclaimed as ABANDONED.
AI_EXECUTION_STALE_SECONDS=900

# Browser dashboards (exact origins, comma-separated; GET only). Empty = no CORS.
CORS_ALLOWED_ORIGINS=

# Federated research (Crossref / NCBI / Europe PMC need no key; polite contact address)
RESEARCH_CONTACT_EMAIL=
NCBI_API_KEY=

# (TRUSTED_PROXY_HOPS is set in the required block at the top.)

# Payments (never "sandbox" in production). Empty = BLOCKED_EXTERNAL_DEPENDENCY
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
WALLET_CURRENCY=USD
