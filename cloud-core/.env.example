# cloud-core environment template. Copy to .env and fill in. NEVER commit .env.
# Only the Phase 17 AI-provider settings are listed here; all other settings
# and their defaults live in app/core/config.py.

# --- Phase 17: AI model provider (AIExecution) ---
# Leave empty unless a real credential is provisioned. Unset = the provider is
# "not configured": no model call is made and no AIExecution row is written.
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_MAX_RESPONSE_BYTES=1000000

# Prices are configuration, never hardcoded. A model not listed here has
# UNKNOWN cost (stored as NULL, never 0), and a Visibility run refuses to
# spend against an unknown cost. Fill with the provider's current published
# prices, per million tokens:
# AI_MODEL_PRICING_JSON={"anthropic/claude-haiku-4-5-20251001":{"input_per_mtok":"<price>","output_per_mtok":"<price>","currency":"USD"}}
AI_MODEL_PRICING_JSON=

AI_VISIBILITY_MODEL=claude-haiku-4-5-20251001
# Comma-separated provider/model fallback targets, tried in order.
AI_VISIBILITY_FALLBACK_TARGETS=
AI_VISIBILITY_MAX_OUTPUT_TOKENS=400
AI_ATTEMPTS_PER_TARGET=2
# A RUNNING execution older than this is reclaimed as ABANDONED.
AI_EXECUTION_STALE_SECONDS=900

# Browser dashboards (exact origins, comma-separated; GET only). Empty = no CORS.
CORS_ALLOWED_ORIGINS=

# Federated research (Crossref / NCBI / Europe PMC need no key; polite contact address)
RESEARCH_CONTACT_EMAIL=
NCBI_API_KEY=

# VPN/proxy advisory on the login page: X-Forwarded-For entries added by your own load balancer / CDN
TRUSTED_PROXY_HOPS=0

# Payments (never "sandbox" in production). Empty = BLOCKED_EXTERNAL_DEPENDENCY
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
WALLET_CURRENCY=USD
