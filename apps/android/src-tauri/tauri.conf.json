{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIOL",
  "version": "0.1.0",
  "identifier": "app.aiol.client",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AIOL",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AIOL",
    "category": "Productivity",
    "shortDescription": "AIOL — ask your organization's knowledge",
    "copyright": "AIOL",
    "icon": [
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
